<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UIData/NodeViewStyle.uss?fileID=7433441132597879392&amp;guid=88b5bc5aad8b5ec4885fdb2de4e8ad02&amp;type=3#NodeViewStyle" />
    <Style src="project://database/Assets/GameplayRecordNodeView.uss?fileID=7433441132597879392&amp;guid=0a219c0c0fb11e0419158fe6331a8cdd&amp;type=3#GameplayRecordNodeView" />
    <ui:VisualElement name="node-border">
        <ui:VisualElement name="title">
            <ui:Label name="title-label" text="ClusterNode" class="unity-text-element unity-label" />
            <ui:VisualElement name="title-button-container">
                <ui:VisualElement name="collapse-button">
                    <ui:VisualElement name="icon" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="contents">
            <ui:VisualElement name="divider" class="horizontal" />
            <ui:VisualElement name="top">
                <ui:VisualElement name="input" />
                <ui:VisualElement name="divider" class="vertical" />
                <ui:VisualElement name="output" />
            </ui:VisualElement>
            <ui:Label text="This is description" display-tooltip-when-elided="true" name="Description" style="display: flex; visibility: visible; width: 100px; white-space: normal;" />
            <ui:Foldout text="Gameplay Detail" name="GameplayDetail" value="false" style="display: flex; visibility: visible;">
                <ui:TextField picking-mode="Ignore" label="userID" value="-1" text="filler text" name="userID" />
                <ui:TextField picking-mode="Ignore" label="StartKeyFrame" value="-1" text="filler text" name="StartKeyframe" />
                <ui:TextField picking-mode="Ignore" label="EndKeyFrame" value="-1" text="filler text" name="EndKeyframe" />
            </ui:Foldout>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="selection-border" picking-mode="Ignore" style="position: absolute;" />
</ui:UXML>
